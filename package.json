{
  "name": "contract-ci-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Учебный проект: CI и контрактное тестирование API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test src/**/*.test.js",
    "test:unit": "node --test src/**/*.test.js",
    "test:ci": "node --test --experimental-test-coverage src/**/*.test.js",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "babel-jest": "^30.5.2"
  }
}
